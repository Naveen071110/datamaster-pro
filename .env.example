# DataMaster Pro — Environment Configuration Template
# All utilities run 100% client-side in-browser via WebAssembly.
# These optional variables can customize client builds or analytics endpoints.

# Application Public Canonical URL
VITE_APP_URL=https://datamaster-pro-78m4.onrender.com

# Optional Environment Mode (development | staging | production)
VITE_APP_ENV=production

# Optional First-Party Analytics Toggle (Disabled by default / requires user cookie consent)
VITE_ANALYTICS_ENABLED=false
